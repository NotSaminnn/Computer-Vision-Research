# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environments
.venv/
venv/
env/

# Data (never commit raw or generated data; manifests ARE committed)
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
!data/manifests/
data/manifests/*
!data/manifests/.gitkeep

# Experiment artefacts (immutable run directories are large; keep the registry)
experiments/*/
!experiments/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
logs/*
!logs/.gitkeep
results/*
!results/.gitkeep
figures/*
!figures/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/

# Isolated environments for model families whose dependencies conflict with the
# main venv (installing them there once corrupted numpy mid-run).
.venv-da3/
.venv-ml/
.venv-models/

# Vendored third-party model code, cloned by setup rather than committed.
third_party/

# LaTeX build products
*.aux
*.bbl
*.blg
*.out
*.synctex.gz
iclr2027/main.log
iclr2027/_*.tex
iclr2027/rm_list.txt
