# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environments
.venv/
venv/
env/

# Data (never commit raw or generated data; manifests ARE committed)
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
!data/manifests/
data/manifests/*
!data/manifests/.gitkeep

# Experiment artefacts (immutable run directories are large; keep the registry)
experiments/*/
!experiments/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
logs/*
!logs/.gitkeep
results/*
!results/.gitkeep
figures/*
!figures/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/
